{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:23.6.1 AS build-client",
  
    "WORKDIR /usr/src/client",
    
    "COPY package*.json ./",
    
    "RUN npm install",
    
    "COPY . ./",

    "ARG VITE_API_URL",
    "ENV VITE_API_URL=$VITE_API_URL",

    "ARG VITE_SECURE",
    "ENV VITE_SECURE=$VITE_SECURE",

    "ARG VITE_TURNSTILE",
    "ENV VITE_TURNSTILE=$VITE_TURNSTILE",

    "ARG VITE_TURNSTILE_KEY",
    "ENV VITE_TURNSTILE_KEY=$VITE_TURNSTILE_KEY",

    "RUN npm run build",

    "FROM nginx:alpine",

    "COPY --from=build-client /usr/src/client/dist /usr/share/nginx/html",
    
    "COPY nginx.conf /etc/nginx/conf.d/default.conf",

    "EXPOSE 80",
    
    "CMD [\"nginx\", \"-g\", \"daemon off;\"]"
  ]
}